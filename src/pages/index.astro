---
import Layout from "../layouts/Layout.astro";

const navItems = ["Plataforma", "Soluciones", "Precios", "Preguntas"];

const trustedBy = [
  "Electronica",
  "Desarrolo web",
  "Robotica",
  "Mecanica",
  "Marketing Digital",
];

const metrics = [
  { value: "+92%", label: "insercion laboral" },
  { value: "+15K", label: "Egresados" },
  { value: "+25 años", label: "De trayectoria" },
];

const audiences = [
  {
    title: "Trackea tus logros",
    copy: "Contaras con un panel de avances, comunidad y próximos hitos para que celebres cada logro.",
  },
  {
    title: "Estudio guiado",
    copy: "Contaras con tutores especializados que te acompañaran durante tu aprendizaje resolviendo tus pregundras y acelerando tu aprendizaje.",
  },
  {
    title: "Comodo Sistema de Pagos",
    copy: "contamos con un sistema de pagos tanto nacional con una disponibilidad completa y respuesta inmediata.",
  },
];

const capabilities = [
  {
    eyebrow: "Area de Computacion",
    title: "Cursos de Desarrollo Web ",
    copy: "Convierte tus ideas en aplicaciones y sotfware de alto nivel.",
    points: [
      "Diseño Frontend: HTML, CSS, Javascript y React, ",
      "Diseño Backend: NodeJS, SQL y Express",
      "Diseños Fullstack: Crea un Portafolios Profesional, desplega tus aplicaciones y unete al mercado laboral",
    ],
  },
  {
    eyebrow: "Area de Ventas",
    title: "Cursos de Marketing Digital",
    copy: "Posiciona tu marca, capta a tus clientes y genera un sistema fluido y optimizado para maximizar tus ganancias ",
    points: [
      "Trafico: Captacion de audiencia con SEO/contenido y SEM/Ads ",
      "Convesion: Aprende el arte de vender, UX/UI design y Funnel Marketing",
      "Analitica y Otimizacion: Entiende el retorno de inversion, el Costo de adquisicion y usa el Testing para crear estrategias en tiempo real",
    ],
  },
  {
    eyebrow: "Area Tecnica",
    title: "Cursos de Robotica",
    copy: "Crea tu propio Automata mientras aprendes habilidades tecnicas, programas microcontroladores e implementas IOT para Domitica",
    points: [
      "Programacion de Arduino, PIC, y ESP32",
      "Diseño de Mecanismos",
      "Sistemas de control Electronicos",
    ],
  },
];

const plans = [
  {
    name: "Compra un curso",
    price: "$45 USD",
    description: "Obten acceso derporvida e ilimitado el contenido de un curso",
    features: [
      "Acceso deporvida para 1 persona",
      "Certificacion avalada",
      "Descuentos en proximos cursos",
      "Asesoria mediante un foro",
    ],
  },
  {
    name: "Mensualidad",
    price: "$25 USD",
    description:
      "Obten un acceso completo a todos nuestro cursos durante un mes.",
    features: [
      "Acceso a clases en vivo",
      "Certificacion avalada",
      "Mentoria via chat",
      "Acceso a eventos masivos",
    ],
  },
  {
    name: "Custom",
    price: "Empresarial",
    description: "Capacita a tu equipo de trabajo de manera especializada",
    features: [
      "Acceso a +10 personas",
      "Certificaion Avalada",
      "Integraciones dedicadas",
      "Acceso a Capacitaciones presenciales",
    ],
  },
];

const faqs = [
  {
    question: "¿Kurzzo tiene clases en vivo?",
    answer:
      "Si, a pesar de que nuestro modelo de estudio es asincrono y cuenta con suficiente material de estudio y lecciones automatizadas sin embargo tendras acceso a conferencias y clases en vivo",
  },
  {
    question: "¿Como puedo pagar?",
    answer:
      "Recibimos moneda nacional a traves de Pago movil,  y Pagos con monedas extrngeras a trbes de Binance",
  },
  {
    question: "¿Mi certificado tiene validez laboral?",
    answer:
      "Sí. Kurzzo es una plataforma del ICPSB el cual ofrece una certificacion avalado por el ministerio de educacion.",
  },
];

const routes = [
  {
    bgImg: "../assets/bgImg.jpg",
  },
];
---

<Layout
  title="Kurzzo"
  description="Kurzzo es una plataforma e-learning en español para vender cursos, coordinar cohortes y construir experiencias de aprendizaje premium."
>

    <header
      class="mx-auto z-100 fixed bg-[#ffffff90] flex w-full items-center justify-between px-6 py-2 lg:px-8"
    > 
      <a
        href="#"
        class="flex items-center gap-3 text-lg font-semibold tracking-tight text-slate-950"
      >
        <span
          class="flex h-10 w-10 items-center justify-center rounded-[10px] font-black bg-brand-600 text-[30px] text-white shadow-lg shadow-brand-700/20"
        >
          K
        </span>
        Kurzzo
      </a>

      <nav
        class="hidden items-center gap-8 text-sm font-medium text-slate-700 lg:flex"
      >
        {
          navItems.map((item) => (
            <a
              href={`#${item.toLowerCase()}`}
              class="transition hover:text-slate-950"
            >
              {item}
            </a>
          ))
        }
      </nav>

      <div class="hidden items-center gap-3 lg:flex">
        <a
          href="#precios"
          class="text-sm font-semibold text-slate-700 transition hover:text-slate-950"
        >
          Ver planes
        </a>
        <a
          href="#cta"
          class="rounded-full bg-slate-950 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-800"
        >
          Agenda una cita
        </a>
      </div>
    </header>

    <main>
      <section
        class="px-6 pb-18 pt-8 lg:px-8 lg:pb-24"
      >
        <div
          class=" pt-12 mx-auto grid w-full max-w-7xl items-center gap-14 lg:grid-cols-[1.05fr_0.95fr]"
        >
          <div class="max-w-2xl">
            <div
              class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-200 bg-white/80 px-4 py-2 text-sm font-medium text-brand-900 shadow-sm shadow-brand-950/5 backdrop-blur"
            >
              <span class="h-2 w-2 rounded-full bg-brand-500"></span>
              Encuentra tu ruta de aprendizaje y vulevete un profesional
            </div>
            <h1
              class="max-w-4xl text-5xl font-black leading-[0.95] tracking-[-0.04em] text-slate-950 sm:text-6xl lg:text-7xl"
            >
              Convierte tu conocimiento en oportunidades.
            </h1>
            <p
              class="mt-6 max-w-xl text-lg leading-8 text-slate-600 sm:text-xl"
            >
              Kurzzo es una plataforma avalada por el ICPSB y el IEFFI con
              certificacion academica que forma profesionales con habilidades
              reales para el campo laboral construyendo tu propia ruta
              apredizaje.
            </p>

            <div class="mt-10 flex flex-col gap-4 sm:flex-row">
              <a
                href="#cta"
                class="inline-flex items-center justify-center rounded-full bg-brand-600 px-6 py-4 text-base font-semibold text-white shadow-lg shadow-brand-700/25 transition hover:bg-brand-700"
              >
                Comienza ahora
              </a>
              <a
                href="#plataforma"
                class="inline-flex items-center justify-center rounded-full border border-slate-300 bg-white/80 px-6 py-4 text-base font-semibold text-slate-900 backdrop-blur transition hover:border-slate-400"
              >
                Explorar la plataforma
              </a>
            </div>

            <div
              class="mt-10 grid gap-5 border-t border-slate-200 pt-8 sm:grid-cols-3"
            >
              {
                metrics.map((metric) => (
                  <div>
                    <p class="text-3xl font-black tracking-[-0.04em] text-slate-950">
                      {metric.value}
                    </p>
                    <p class="mt-2 text-sm leading-6 text-slate-600">
                      {metric.label}
                    </p>
                  </div>
                ))
              }
            </div>
          </div>

          <div class="relative">
            <div
              class="absolute inset-x-10 top-6 -z-10 h-72 rounded-full bg-brand-200/80 blur-3xl"
            >
            </div>
            <div class="rounded-[1.6rem] bg-slate-950 p-6 text-white">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-sm font-medium text-white/70">conocenos</p>
                  <h2 class="mt-2 text-2xl font-bold">
                    Estudia desde cualquier lugar Garantizando lograr tus
                    objetivos
                  </h2>
                </div>
                <div
                  class="rounded-full bg-white/10 px-3 py-1 text-center text-xs font-semibold text-brand-200"
                >
                  Inscripciones abiertas
                </div>
              </div>

              <div class="mt-8 grid gap-4 sm:grid-cols-3">
                <div class="rounded-3xl bg-white/8 p-4">
                  <p class="text-sm text-white/65">Matriculaciones mensuales</p>
                  <p class="mt-3 text-3xl font-black">184</p>
                  <p class="mt-2 text-xs text-brand-200">+22% esta semana</p>
                </div>
                <div class="rounded-3xl bg-brand-500/14 p-4">
                  <p class="text-sm text-white/65">Cursos disponibles</p>
                  <p class="mt-3 text-3xl font-black">10</p>
                  <p class="mt-2 text-xs text-brand-200">
                    Con agenda y recordatorios
                  </p>
                </div>
                <div class="rounded-3xl bg-white/8 p-4">
                  <p class="text-sm text-white/65">Taza de Finalización</p>
                  <p class="mt-3 text-3xl font-black">81%</p>
                  <p class="mt-2 text-xs text-brand-200">
                    Muy por encima del promedio
                  </p>
                </div>
              </div>

              <div class="mt-6 grid gap-4 lg:grid-cols-[1.1fr_0.9fr]">
                <div class="rounded-3xl bg-white p-5 text-slate-950">
                  <div class="flex items-center justify-between">
                    <p class="text-sm font-semibold text-slate-500">
                      Embudo de conversión
                    </p>
                    <p class="text-sm font-semibold text-brand-700">3.8% CVR</p>
                  </div>
                  <div class="mt-6 space-y-4">
                    <div>
                      <div
                        class="mb-2 flex items-center justify-between text-sm text-slate-600"
                      >
                        <span>Visitas a la landing</span>
                        <span>24.120</span>
                      </div>
                      <div class="h-3 rounded-full bg-brand-100">
                        <div class="h-3 w-[88%] rounded-full bg-brand-500">
                        </div>
                      </div>
                    </div>
                    <div>
                      <div
                        class="mb-2 flex items-center justify-between text-sm text-slate-600"
                      >
                        <span>Leads calificados</span>
                        <span>3.460</span>
                      </div>
                      <div class="h-3 rounded-full bg-brand-100">
                        <div class="h-3 w-[57%] rounded-full bg-brand-600">
                        </div>
                      </div>
                    </div>
                    <div>
                      <div
                        class="mb-2 flex items-center justify-between text-sm text-slate-600"
                      >
                        <span>Matrículas activas</span>
                        <span>916</span>
                      </div>
                      <div class="h-3 rounded-full bg-brand-100">
                        <div class="h-3 w-[34%] rounded-full bg-slate-950">
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="rounded-3xl border border-white/10 bg-white/8 p-5">
                  <p class="text-sm font-semibold text-white/70">
                    Contamos con servicios pensados para ti
                  </p>
                  <ul class="mt-5 space-y-3 text-sm text-white/90">
                    <li
                      class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3"
                    >
                      Cursos de alta calidad y con un enfoque practico
                    </li>
                    <li
                      class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3"
                    >
                      Precios y sistemas de pago que se ajustan a tu necesidad
                    </li>
                    <li
                      class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3"
                    >
                      Disponibilidad completa gracias al enfoque de estudio
                      asincrono
                    </li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section
        class="border-y border-slate-200/80 bg-white/70 px-6 py-6 backdrop-blur lg:px-8"
      >
        <div
          class="mx-auto flex w-full max-w-7xl flex-col gap-5 lg:flex-row lg:items-center lg:justify-between"
        >
          <p
            class="text-sm font-semibold uppercase tracking-[0.24em] text-slate-500"
          >
            Que areas puedes aprender en Kurzzo?
          </p>
          <div
            class="grid grid-cols-2 gap-4 text-sm font-semibold text-slate-700 sm:grid-cols-3 lg:flex lg:flex-wrap lg:justify-end lg:gap-8"
          >
            {
              trustedBy.map((brand) => (
                <span class="rounded-full border border-slate-200 bg-white px-4 py-2 text-center">
                  {brand}
                </span>
              ))
            }
          </div>
        </div>
      </section>

      <section id="plataforma" class="px-6 py-24 lg:px-8">
        <div class="mx-auto w-full max-w-7xl">
          <div class="max-w-3xl">
            <p
              class="text-sm font-semibold uppercase tracking-[0.24em] text-brand-700"
            >
              Kurzzo
            </p>
            <h2
              class="mt-4 text-4xl font-black tracking-[-0.04em] text-slate-950 sm:text-5xl"
            >
              El lugar perfecto para aprender creando.
            </h2>
            <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600">
              En lugar de informacion dispersa y superficial, Kurzzo ofrece
              educacion especializada de alto nivel, una comunidad de
              profesionales y una experiencia de aprendizaje unica pensada para
              que logres tus objetivos.
            </p>
          </div>

          <div class="mt-14 grid gap-6 lg:grid-cols-3">
            {
              capabilities.map((item, index) => (
                <article
                  class={`rounded-4xl border p-8 shadow-lg shadow-brand-950/5 ${index === 1 ? "border-brand-200 bg-brand-50" : "border-slate-200 bg-white"}`}
                >
                  <p class="text-sm font-semibold uppercase tracking-[0.22em] text-brand-700">
                    {item.eyebrow}
                  </p>
                  <h3 class="mt-4 text-2xl font-bold tracking-[-0.03em] text-slate-950">
                    {item.title}
                  </h3>
                  <p class="mt-4 text-base leading-7 text-slate-600">
                    {item.copy}
                  </p>
                  <ul class="mt-6 space-y-3 text-sm leading-6 text-slate-700">
                    {item.points.map((point) => (
                      <li class="flex gap-3">
                        <span class="mt-2 h-2.5 w-2.5 rounded-full bg-brand-500" />
                        <span class="w-[90%]">{point}</span>{" "}
                      </li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section
        id="soluciones"
        class="bg-slate-950 px-6 py-24 text-white lg:px-8"
      >
        <div
          class="mx-auto grid w-full max-w-7xl gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center"
        >
          <div>
            <p
              class="text-sm font-semibold uppercase tracking-[0.24em] text-brand-300"
            >
              Soluciones
            </p>
            <h2 class="mt-4 text-4xl font-black tracking-[-0.04em] sm:text-5xl">
              Un modelo educativo moderno, practico y disenado para tu
              comodidad.
            </h2>
            <p class="mt-6 text-lg leading-8 text-white/70">
              Desde una mentoría premium hasta una universidad corporativa,
              Kurzzo se adapta sin perder simplicidad ni velocidad de ejecución.
            </p>
          </div>

          <div class="grid gap-5">
            {
              audiences.map((audience) => (
                <article class="rounded-[1.8rem] border border-white/10 bg-white/5 p-7 backdrop-blur">
                  <h3 class="text-2xl font-bold tracking-[-0.03em]">
                    {audience.title}
                  </h3>
                  <p class="mt-3 text-base leading-7 text-white/70">
                    {audience.copy}
                  </p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section id="precios" class="px-6 py-24 lg:px-8">
        <div class="mx-auto w-full max-w-7xl">
          <div
            class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between"
          >
            <div class="max-w-3xl">
              <p
                class="text-sm font-semibold uppercase tracking-[0.24em] text-brand-700"
              >
                Precios
              </p>
              <h2
                class="mt-4 text-4xl font-black tracking-[-0.04em] text-slate-950 sm:text-5xl"
              >
                Encuentra un plan que se adapte a tu necesidad.
              </h2>
            </div>
            <p class="max-w-xl text-base leading-7 text-slate-600">
              estudia de manera asincrona, semipresencial o accede a fomaciones
              empresariles personalizadas.
            </p>
          </div>

          <div class="mt-14 grid gap-6 lg:grid-cols-3">
            {
              plans.map((plan, index) => (
                <article
                  class={`rounded-4xl border p-8 shadow-lg shadow-brand-950/5 ${index === 1 ? "border-brand-300 bg-slate-950 text-white" : "border-slate-200 bg-white text-slate-950"}`}
                >
                  <div class="flex items-center justify-between">
                    <h3 class="text-2xl font-bold tracking-[-0.03em]">
                      {plan.name}
                    </h3>
                    {index === 1 && (
                      <span class="rounded-full bg-brand-500/20 px-3 py-1 text-xs font-semibold text-brand-200">
                        Más elegido
                      </span>
                    )}
                  </div>
                  <p
                    class={`mt-4 text-4xl font-black tracking-[-0.04em] ${index === 1 ? "text-white" : "text-slate-950"}`}
                  >
                    {plan.price}
                  </p>
                  <p
                    class={`mt-4 text-base leading-7 ${index === 1 ? "text-white/70" : "text-slate-600"}`}
                  >
                    {plan.description}
                  </p>
                  <ul
                    class={`mt-6 space-y-3 text-sm leading-6 ${index === 1 ? "text-white/90" : "text-slate-700"}`}
                  >
                    {plan.features.map((feature) => (
                      <li class="flex gap-3">
                        <span
                          class={`mt-2 h-2.5 w-2.5 rounded-full ${index === 1 ? "bg-brand-300" : "bg-brand-500"}`}
                        />
                        <span>{feature}</span>
                      </li>
                    ))}
                  </ul>
                  <a
                    href="#cta"
                    class={`mt-8 inline-flex w-full items-center justify-center rounded-full px-5 py-3 text-sm font-semibold transition ${index === 1 ? "bg-brand-500 text-white hover:bg-brand-400" : "bg-slate-950 text-white hover:bg-slate-800"}`}
                  >
                    Solicitar acceso
                  </a>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section id="recursos" class="bg-white px-6 py-24 lg:px-8">
        <div class="mx-auto w-full max-w-7xl">
          <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
            <div>
              <p
                class="text-sm font-semibold uppercase tracking-[0.24em] text-brand-700"
              >
                Preguntas frecuentes
              </p>
              <h2
                class="mt-4 text-4xl font-black tracking-[-0.04em] text-slate-950 sm:text-5xl"
              >
                Lo esencial para decidir si Kurzzo encaja contigo.
              </h2>
            </div>

            <div class="grid gap-4">
              {
                faqs.map((faq) => (
                  <article class="rounded-[1.8rem] border border-slate-200 bg-brand-50 p-7">
                    <h3 class="text-xl font-bold tracking-[-0.03em] text-slate-950">
                      {faq.question}
                    </h3>
                    <p class="mt-3 text-base leading-7 text-slate-600">
                      {faq.answer}
                    </p>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <section id="cta" class="px-6 pb-24 pt-12 lg:px-8">
        <div
          class="mx-auto w-full max-w-7xl rounded-[2.5rem] bg-slate-950 px-8 py-14 text-white shadow-[0_32px_120px_-40px_rgba(15,23,42,0.75)] sm:px-12"
        >
          <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
            <div class="max-w-3xl">
              <p
                class="text-sm font-semibold uppercase tracking-[0.24em] text-brand-300"
              >
                Kurzzo
              </p>
              <h2
                class="mt-4 text-4xl font-black tracking-[-0.04em] sm:text-5xl"
              >
                Aprende habilides reales y necesarias en el mercado laboral
                actual y conviertete en un profesional.
              </h2>
              <p class="mt-5 text-lg leading-8 text-white/70">
                No pierdas mas tiempo, encuntra con nosotros tu ruta de
                aprendizaje, vuelvete un profesional en tu area y comienza a
                generar ingresos.
              </p>
            </div>
            <div class="flex flex-col gap-4 sm:flex-row lg:flex-col">
              <a
                href="#"
                class="inline-flex items-center justify-center rounded-full bg-brand-500 px-6 py-4 text-base font-semibold text-white transition hover:bg-brand-400"
              >
                Comienza ahora
              </a>
              <a
                href="#precios"
                class="inline-flex items-center justify-center rounded-full border border-white/15 bg-white/5 px-6 py-4 text-base font-semibold text-white transition hover:bg-white/10"
              >
                Ver planes
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer
      class="border-t border-slate-200 bg-white/80 px-6 py-8 backdrop-blur lg:px-8"
    >
      <div
        class="mx-auto flex w-full max-w-7xl flex-col gap-4 text-sm text-slate-500 sm:flex-row sm:items-center sm:justify-between"
      >
        <p>
          © 2026 Kurzzo. Plataforma e-learning para equipos que enseñan con
          ambición.
        </p>
        <div class="flex gap-6">
          <a href="#plataforma" class="transition hover:text-slate-950"
            >Producto</a
          >
          <a href="#precios" class="transition hover:text-slate-950">Precios</a>
          <a href="#recursos" class="transition hover:text-slate-950">FAQ</a>
        </div>
      </div>
    </footer>
  </div>
</Layout>
